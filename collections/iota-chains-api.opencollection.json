        {
          "info": {
            "name": "Estimates gas for a given on-ledger ISC request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/chain/estimategas-onledger",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Estimates gas usage for a given on-ledger ISC request. To calculate required L1 and L2 gas budgets use values of L1.GasBudget and L2.GasBurned respectively."
        },
        {
          "info": {
            "name": "Ethereum JSON-RPC",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/chain/evm"
          },
          "docs": "Ethereum JSON-RPC"
        },
        {
          "info": {
            "name": "Ethereum JSON-RPC (Websocket transport)",
            "type": "http"
          },
          "http": {
            "method": "GET",
