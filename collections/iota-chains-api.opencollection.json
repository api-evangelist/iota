          },
          "docs": "Ethereum JSON-RPC (Websocket transport)"
        },
        {
          "info": {
            "name": "Get the contents of the mempool.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/chain/mempool",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get the contents of the mempool."
