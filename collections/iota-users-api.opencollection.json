{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wasp auth users API",
    "version": "0"
  },
  "items": [
    {
      "info": {
        "name": "users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of all users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/users",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get a list of all users"
        },
        {
          "info": {
            "name": "Add a user",
